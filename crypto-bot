@bot.message_handler(func=lambda message: message.text == "🔄 Almashtirish")
def exchange_start(message):
    user_exchange_state[message.from_user.id] = {"give": None, "get": None}
    show_exchange_menu(message.chat.id, message.from_user.id, edit=False)

def show_exchange_menu(chat_id, user_id, message_id=None, edit=True):
    state = user_exchange_state.get(user_id, {"give": None, "get": None})
    markup = types.InlineKeyboardMarkup(row_width=2)
    
    for code, data in RATES.items():
        give_prefix = "✅ " if state["give"] == code else "⬆️ "
        get_prefix = "✅ " if state["get"] == code else "⬇️ "
        
        markup.add(
            types.InlineKeyboardButton(f"{give_prefix}{data['name']}", callback_data=f"give_{code}"),
            types.InlineKeyboardButton(f"{get_prefix}{data['name']}", callback_data=f"get_{code}")
        )
    markup.add(types.InlineKeyboardButton("🚫 Bekor qilish", callback_data="back_to_main"))
    
    text = "Berish va ⬇️ Olish valyutalarini tanlang:"
    if edit and message_id:
        try:
            bot.edit_message_text(text, chat_id, message_id, reply_markup=markup)
        except Exception:
            bot.send_message(chat_id, text, reply_markup=markup)
    else:
        bot.send_message(chat_id, text, reply_markup=markup)

@bot.callback_query_handler(func=lambda call: call.data.startswith("give_") or call.data.startswith("get_"))
def process_exchange_selection(call):
    user_id = call.from_user.id
    if user_id not in user_exchange_state:
        user_exchange_state[user_id] = {"give": None, "get": None}
    
    action, code = call.data.split("_", 1)
    
    if action == "give":
        user_exchange_state[user_id]["give"] = code
    else:
        user_exchange_state[user_id]["get"] = code
        
    state = user_exchange_state[user_id]
    
    if state["give"] and state["get"]:
        give_name = RATES[state["give"]]["name"]
        get_name = RATES[state["get"]]["name"]
        wallet_to_show = WALLETS.get(state["give"], WALLETS.get("HUMO", "Kiritilmagan"))
        
        text = (
            f"Almashuv:\n"
            f"🔄: {give_name} ➡️ {get_name}\n"
            f"Berasiz: * {give_name} 🔻\n"
            f"Olasiz: * {get_name} 🇺🇿\n"
            f"Qabul qiluvchi rekvizit: `{wallet_to_show}`\n\n"
            f"⚠️ *Diqqat: Minimal almashtirish ekvivalenti 50 000 so'm!*"
        )
        
        markup = types.InlineKeyboardMarkup(row_width=1)
        markup.add(
            types.InlineKeyboardButton(f"🔻 Berish miqdorini kiritish", callback_data=f"input_amt_{state['give']}_{state['get']}"),
            types.InlineKeyboardButton("🚫 Bekor qilish", callback_data="back_to_main")
        )
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id, reply_markup=markup, parse_mode="Markdown")
    else:
        show_exchange_menu(call.message.chat.id, user_id, call.message.message_id, edit=True)

@bot.callback_query_handler(func=lambda call: call.data.startswith("input_amt_"))
def ask_amount(call):
    data = call.data.split("_")
    give_code = data[2]
    get_code = data[3]
    
    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("🔙 Orqaga", callback_data="back_to_exchange"))
    
    bot.edit_message_text(f"Berish miqdorini {RATES[give_code]['name']} da kiriting\n(Minimal summa: 50 000 so'mga teng bo'lishi kerak):", call.message.chat.id, call.message.message_id, reply_markup=markup)
    bot.register_next_step_handler(call.message, get_exchange_amount, give_code, get_code)

def get_exchange_amount(message, give_code, get_code):
    if message.text == "/start" or message.text == "🔄 Almashtirish":
        return
    if not message.text.replace('.', '', 1).isdigit():
        bot.send_message(message.chat.id, "Iltimos, faqat raqam ko'rinishida kiriting!")
        bot.register_next_step_handler(message, get_exchange_amount, give_code, get_code)
        return
    
    amount = float(message.text)
    rate = RATES[give_code]["sell"] if RATES[give_code]["sell"] > 0 else 1
    total_uzs = amount * rate

    # --- 50 000 SO'M MINIMAL CHEGARANI TEKSHIRISH ---
    if total_uzs < MIN_DEPOSIT_UZS:
        bot.send_message(
            message.chat.id,
            f"❌ Xatolik! Minimal almashtirish miqdori **50 000 so'm**dan kam bo'lmasligi kerak.\n"
            f"Siz kiritgan miqdor qiymati: {total_uzs:,.2f} UZS. Iltimos, kattaroq miqdor kiriting:",
            parse_mode="Markdown"
        )
        bot.register_next_step_handler(message, get_exchange_amount, give_code, get_code)
        return

    wallet_to_show = WALLETS.get(give_code, WALLETS.get("HUMO", "Kiritilmagan"))

    text = f"Eslatmalar:\n- Tarmoq qoidalariga amal qiling;\n\nHamyon/Karta: `{wallet_to_show}`\n\nMiqdor: {amount} {give_code}\nOlish summasi: {total_uzs:,.2f} UZS\n\nTo'lov o'tgach «To'lov qildim» tugmasini bosing."
    
    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("To'lov qildim ✅", callback_data=f"payconf_{give_code}_{amount}_{total_uzs}"))
    markup.add(types.InlineKeyboardButton("🔙 Orqaga", callback_data="back_to_exchange"))
    
    bot.send_message(message.chat.id, text, reply_markup=markup, parse_mode="Markdown")

